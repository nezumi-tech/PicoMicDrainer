<Window x:Class="PicoMicDrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PICO Mic Drainer" Height="250" Width="450"
        Visibility="Hidden"
        ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="15">
        <ScrollViewer>
            <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" />
        </ScrollViewer>
    </Grid>
</Window>