<Window x:Class="PicoMicDrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PICO Mic Drainer" Height="300" Width="450"
        Visibility="Hidden"
        ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" />
        </ScrollViewer>

        <CheckBox x:Name="VisualizerCheck" Grid.Row="1" 
                  Content="音声入力を可視化する（レベルメーター有効化）" 
                  Margin="0,5,0,5" Checked="VisualizerCheck_Changed" Unchecked="VisualizerCheck_Changed"/>

        <ProgressBar x:Name="VolumeBar" Grid.Row="2" 
                     Height="15" Minimum="0" Maximum="100" Value="0" 
                     Foreground="#FF00FF7F" Background="#FF333333" BorderThickness="0"/>
    </Grid>
</Window>