<Window x:Class="PicoMicDrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PicoMicDrainer" Height="300" Width="450"
        Visibility="Hidden"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 追加: アップデート通知用 -->
            <RowDefinition Height="*" />
            <!-- ログ用 -->
            <RowDefinition Height="Auto" />
            <!-- トグル用 -->
            <RowDefinition Height="Auto" />
            <!-- メーター用 -->
        </Grid.RowDefinitions>

<!-- ★追加: アップデート通知パネル (初期状態は Visibility="Collapsed" で非表示) -->
        <Border x:Name="UpdatePanel" Grid.Row="0" Background="#E6F2FF" BorderBrush="#0078D7" BorderThickness="1" Margin="0,0,0,10" Padding="10" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" FontSize="14">
            <Run x:Name="UpdateTitleRun" FontWeight="Bold" Foreground="#003366"/>
            <LineBreak/>
            <!-- ここにBOOTHのURLを設定します -->
            <Hyperlink NavigateUri="https://nezumi-tech.booth.pm/items/8434266?utm_source=update_notice" RequestNavigate="Hyperlink_RequestNavigate">
                <Run x:Name="DownloadLinkRun"/>
            </Hyperlink>
        </TextBlock>
    </Border>

        <!-- 既存のUI要素（Grid.Rowの番号を1つずつずらしています） -->
        <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" />
        </ScrollViewer>

        <CheckBox x:Name="VisualizerCheck" Grid.Row="2" 
              Margin="0,5,0,5" Checked="VisualizerCheck_Changed" Unchecked="VisualizerCheck_Changed"/>

        <ProgressBar x:Name="VolumeBar" Grid.Row="3" 
                 Height="15" Minimum="0" Maximum="100" Value="0" 
                 Foreground="#FF00FF7F" Background="#FF333333" BorderThickness="0"/>
    </Grid>
</Window>